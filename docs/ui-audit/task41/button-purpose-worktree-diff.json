        "+",
        "+/* ---- TASK-41: 업무 중심의 공통 시각 계층 (DESIGN.md) ---- */",
        "+.page-head > h1 { font-size: 26px; line-height: 35px; }",
        "+.layout > main { gap: 20px; }",
        "+.layout > main:has(> .settings-tabs) { max-width: 880px; }",
        "+.settings-tabs ~ .card form.stack { max-width: 560px; }",
        "+.t12, .today-scope-label, .today-assigned-stats span { font-size: 13px; line-height: 19px; }",
        "+.header { box-shadow: 0 1px 0 rgba(25, 40, 47, .02); }",
        "+.rail { padding-top: 24px; }",
        "+.rail a { border-radius: var(--radius-control); }",
        "+.rail .initial { background: transparent; border: 1px solid var(--border); }",
        "+.project-summary { gap: 16px; }",
        "+.layout > main:has(> .project-summary) { gap: 12px; }",
        "+.project-task-surface { padding: 16px 20px; gap: 12px; }",
        "+.project-summary-head { align-items: center; gap: 12px 24px; }",
        "+.project-summary-copy { flex: 1 1 280px; gap: 6px; }",
        "+.project-meta { gap: 6px 12px; }",
        "+.project-kpis, .org-kpis { gap: 0; padding-top: 12px; border-top: 1px solid var(--border); }",
        "+.project-kpis .tile, .org-kpis .tile {",
        "+  min-width: 0; min-height: 68px; padding: 8px 16px; gap: 2px;",
        "+  border: 0; border-left: 1px solid var(--border); border-radius: 0; background: transparent;",
        "+}",
        "+.project-kpis .tile:first-child, .org-kpis .tile:first-child { border-left: 0; }",
        "+.project-kpis .tile b, .org-kpis .tile b { font-size: 24px; line-height: 31px; font-weight: 650; }",
        "+.project-kpis .tile span, .org-kpis .tile span { font-size: 13px; line-height: 19px; }",
        "+ul.tasks { gap: 0; border: 1px solid var(--border); border-radius: var(--radius-surface); }",
        "+ul.tasks > .task-row {",
        "+  min-height: 80px; padding: 14px 16px; border: 0; border-bottom: 1px solid var(--border); border-radius: 0;",
        "+}",
        "+ul.tasks > .task-row:first-child { border-radius: 8px 8px 0 0; }",
        "+ul.tasks > .task-row:last-child { border-bottom: 0; border-radius: 0 0 8px 8px; }",
        "+ul.tasks > .task-row:only-child { border-radius: 8px; }",
        "+.task-row .title, .task-row .next { font-size: 15px; line-height: 23px; font-weight: 600; }",
        "+.pill { border-radius: var(--radius-control); font-weight: 600; }",
        "+.board .col { border-style: solid; background: var(--bg-secondary); }",
        "+.board .task-row { border-radius: var(--radius-control); }",
        "+.board ul.tasks { gap: 8px; border: 0; }",
        "+.board ul.tasks > .task-row {",
        "+  min-height: 0; padding: 12px; border: 1px solid var(--border); border-radius: var(--radius-control);",
        "+}",
        "+.today-focus {",
        "+  padding: 16px 20px; border-left: 3px solid var(--primary); background: var(--bg-secondary); gap: 10px;",
        "+}",
        "+.today-focus h2 { font-size: 24px; line-height: 32px; }",
        "+.today-head-card { gap: 16px; }",
        "+.today-list-card { gap: 12px; }",
        "+.today-list-tools { gap: 8px 12px; }",
        "+.today-assigned-stats a { background: transparent; padding: 4px 10px; border-left: 1px solid var(--border); border-radius: 0; }",
        "+.today-assigned-stats a:first-child { border-left: 0; }",
        "+.panel { border-radius: var(--radius-surface); }",
        "+.panel-body > .stack { gap: 16px; }",
        "+.panel textarea { min-height: 88px; }",
        "+.task-due-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px 12px; }",
        "+.task-due-row > .label, .task-due-row > #extend-form, .task-due-row > form { grid-column: 1 / -1; }",
        "+.task-due-row > .btn.link { min-height: 32px; padding: 0 8px; font-size: 13px; }",
        "+.note-item { border-radius: var(--radius-control); }",
        "+.note-editor-card .doc, #doc-editor .doc { margin-top: 8px; padding-top: 20px; border-top: 1px solid var(--border); }",
        "+.tl-head .tl-track { height: 42px; align-items: end; }",
        "+.tl-today-label > span { position: absolute; top: 0; left: 4px; color: var(--danger); font-size: 12px; white-space: nowrap; }",
        "+@media (min-width: 701px) {",
        "+  .btn { height: 38px; }",
        "+  .btn.primary { height: 40px; }",
        "+  .input, .select, input:not([type=checkbox]):not([type=radio]):not([type=hidden]):not([type=submit]), select { height: 38px; }",
        "+  .input.lg { height: 48px; }",
        "+}",
        "+@media (max-width: 700px) {",
        "+  .layout > main { gap: 16px; }",
        "+  .page-head > h1 { font-size: 24px; line-height: 32px; }",
        "+  .card { padding: 16px; }",
        "+  .project-summary-copy { flex-basis: auto; }",
        "+  .project-actions { margin-top: 6px; }",
        "+  .tiles.five.project-kpis, .org-kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }",
        "+  .project-kpis .tile, .org-kpis .tile { min-height: 64px; padding: 10px 12px; }",
        "+  .project-kpis .tile:nth-child(3n+1), .org-kpis .tile:nth-child(3n+1) { border-left: 0; }",
        "+  .project-kpis .tile:nth-child(n+4), .org-kpis .tile:nth-child(n+4) { border-top: 1px solid var(--border); }",
        "+  .project-kpis .tile span, .org-kpis .tile span { white-space: normal; }",
        "+  ul.tasks > .task-row { min-height: 0; padding: 14px 12px; gap: 10px; }",
        "+  .btn, .btn.sm, .btn.icon, .pill, .pill.sm, .panel .meta .select, .panel .meta .pill.sm,",
        "+  .today-auto-pull .select, .today-schedule-toggle { min-height: 44px; height: 44px; }",
        "+  .btn.icon, .task-row:not(.today-task-row) [data-copy] { min-width: 44px; }",
        "+  .btn.link { height: auto; }",
        "+  .panel .meta { gap: 8px; }",
        "+  .panel .meta .select, input:not([type=checkbox]):not([type=radio]):not([type=hidden]), select, textarea { font-size: 16px; }",
        "+  .panel .title-input { font-size: 20px; line-height: 27px; min-height: 48px; }",
        "+  .task-due-row > .btn.link { min-height: 44px; }",
        "+  .today-focus { padding: 8px 0 8px 12px; margin-top: 12px; gap: 8px; }",
        "+  .today-head-card .today-focus h2 { font-size: 22px; line-height: 1.35; }",
        "+  .today-metrics .stat {",
        "+    min-height: 32px; padding: 4px 6px; flex-direction: row; align-items: baseline; gap: 4px;",
        "+  }",
        "+  .today-metrics .stat span { font-size: 12px; }",
        "+  .note-editor-card .doc, #doc-editor .doc { padding-top: 20px; }",
        "+  .blk-h.h1 .txt { font-size: 22px; line-height: 30px; }",
        "+}",
        "+@media (pointer: coarse) {",
        "+  .doc-edit-toolbar > .muted { display: none; }",
        "+}",
        "+@media (prefers-reduced-motion: reduce) {",
        "+  .task-row, .task-row [data-copy], .caret, .filter-chevron { transition: none; }",
        "+}"
      ]
    },
