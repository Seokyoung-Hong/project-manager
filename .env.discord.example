# discord·discord-bot 컨테이너 전용. `.env.discord`로 복사해 채운다(git에 올리지 않는다).
# 이 파일의 두 비밀(DISCORD_BOT_TOKEN, CORE_TOKEN)은 core DB·화면·로그·/ops 어디에도 없다.

CORE_URL=http://web:8000
# discord-bot 계정의 `bot` 범위 토큰. 그 계정은 조직 **멤버**면 된다(관리자 승격 불필요).
# 발급은 서버 셸 한 줄로만 한다 — 웹 화면에서는 bot 범위를 만들 수 없다(GUIDE-04 Step 7).
CORE_TOKEN=pm_xxx
ORG_ID=1

# Developer Portal → Bot → [Reset Token]. 이때 한 번만 보인다. 이 파일 밖으로 내보내지 않는다.
DISCORD_BOT_TOKEN=
# 주간 보고와 'DM을 보낼 수 없다' 통보가 갈 채널 id(개발자 모드 → 채널 우클릭 → ID 복사).
# 비밀이 아니지만 없으면 컨테이너가 기동하지 않는다(Config.need).
DISCORD_CHANNEL_ID=
# 슬래시 명령을 등록하고 팀·프로젝트 채널을 만들 서버 id. 비우면 DM 명령만 동작한다.
DISCORD_GUILD_ID=

TZ=Asia/Seoul
SEND_HOUR=9
WEEKLY_WEEKDAY=0
WEEKLY_HOUR=9
# 미구현: 값을 넣어도 주간 보고는 고정 형식으로 나간다. 비워 둔다.
LLM_PROVIDER=
SITE_NAME=유달리
