# --- core (web) ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0

# 앞단 리버스 프록시(NginxProxyManager·Cloudflare Tunnel)가 붙는 도메인.
# `web`는 compose 내부 호출용(mcp·discord가 http://web:8000 으로 부른다). 빼면 그 요청이 400이 된다.
ALLOWED_HOSTS=project.dorm.sio2.kr,web
CSRF_TRUSTED_ORIGINS=https://project.dorm.sio2.kr
# 초대 링크·태스크 바로가기·GitHub OAuth 콜백이 전부 이 주소로 만들어진다.
SITE_URL=https://project.dorm.sio2.kr
# 켤 선택 서비스. mcp(원격 MCP 커넥터)·discord·tunnel을 쉼표로. 운영 서버는 mcp를 켠다.
# COMPOSE_PROFILES=mcp
# MCP 서버의 공개 주소. /settings/tokens의 AI 클라이언트 연결 예시가 이 주소로 그려진다.
MCP_URL=https://mcp.sio2.kr

POSTGRES_PASSWORD=change-me

# 호스트 쪽 포트. 앞단 프록시가 붙는 포트에 맞춘다(운영 서버는 web 8080·mcp 8081). 둘이 겹치면 기동이 안 된다.
# 바인드 주소를 같이 쓸 수 있다 — `127.0.0.1:8080`이면 루프백만, `8080`이면 모든 인터페이스(프록시가 다른 장비에 있을 때).
WEB_PORT=8000
MCP_PORT=127.0.0.1:8080
# mcp를 프록시 뒤로 공개할 때만. 그 도메인(과 필요하면 `IP:포트`)을 쉼표로. 비우면 루프백에서만 받는다.
MCP_ALLOWED_HOSTS=

# --- WebMCP (브라우저 안 AI 에이전트) ---
# 크롬 149·엣지 150에서는 아직 오리진 트라이얼이라 도메인마다 토큰을 받아야 켜진다.
# https://developer.chrome.com/origintrials 에서 SITE_URL 도메인으로 등록한다.
# 비워 두면 도구 등록만 조용히 빠지고 나머지 화면은 그대로 돈다.
WEBMCP_ORIGIN_TRIAL=

# --- cloudflared (profile: tunnel) ---
# 외부 리버스 프록시를 쓰면 비워 둔다.
CLOUDFLARE_TUNNEL_TOKEN=

# --- GitHub App (GUIDE-V2-07부터 쓰인다) ---
# 등록 절차는 docs/GITHUB-APP-SETUP.md. 값이 비어 있으면 GitHub 화면이 아예 뜨지 않는다.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# .pem 파일 내용을 한 줄로. 줄바꿈 자리에 \n 을 넣는다.
GITHUB_APP_PRIVATE_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=

# --- Discord (IMPL-PLAN-4 §8.4) ---
# 앱의 Client ID(Application ID). 비밀이 아니다. 조직이 봇을 자기 서버에 설치하는 링크를 만드는 데 쓴다.
# 비우면 조직 화면의 Discord 탭이 뜨지 않는다. 봇 토큰은 .env.discord에만 둔다.
DISCORD_CLIENT_ID=

# discord_service의 설정은 이 파일에 없다. `.env.discord.example` → `.env.discord`를 쓴다.
# Discord 봇 토큰과 CORE_TOKEN이 web 프로세스의 환경에까지 들어가지 않게 나눠 둔 것이다.
